DATABASE_URL=postgres://postgres:postgres@localhost:5432/lms
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Get from https://console.groq.com/keys — never commit a real key here;
# a previous real key was committed to this file and must be treated as
# compromised (rotated in Secret Manager, not reused).
GROQ_API_KEY=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lms-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
WEB_ORIGIN=http://localhost:3000
# Get from @BotFather; chat id is the numeric id of the destination chat/channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
